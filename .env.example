# Supabase Configuration
# Obtain these from your Supabase project dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Note: NEVER expose SUPABASE_SERVICE_ROLE_KEY here.
# Only the public anon key should be provided to the client application.
